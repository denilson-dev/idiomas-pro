{
  "name": "idiomas-pro-placement",
  "private": true,
  "type": "module",
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run db:generate && npm run build -w server && npm run build -w client",
    "build:vercel": "npm run build -w client",
    "build:render": "npm run build",
    "start": "npm run start -w server",
    "render:start": "npm run admin:ensure && npm run db:seed && npm run start",
    "db:generate": "prisma generate --config prisma7.config.ts",
    "db:migrate": "prisma migrate dev --config prisma7.config.ts --name init",
    "db:deploy": "prisma migrate deploy --config prisma7.config.ts",
    "db:seed": "tsx prisma/seed.ts",
    "db:setup:production": "npm run admin:ensure && npm run db:seed",
    "db:studio": "prisma studio --config prisma7.config.ts",
    "test:unit": "vitest run --config vitest.server.config.ts && vitest run --config vitest.client.config.ts",
    "test:api": "vitest run --config vitest.api.config.ts",
    "test:e2e": "npm run build && playwright test",
    "test:all": "npm run test:unit && npm run test:api && npm run test:e2e",
    "test": "npm run test:unit && npm run test:api",
    "data:init": "python data-engineering/pipeline.py init",
    "data:extract": "python data-engineering/pipeline.py extract",
    "data:transform": "python data-engineering/pipeline.py transform",
    "data:quality": "python data-engineering/pipeline.py quality",
    "data:run": "python data-engineering/pipeline.py run-all",
    "data:synthetic": "python data-engineering/synthetic/generate.py",
    "admin:ensure": "npm run db:deploy && npm run db:generate && tsx scripts/ensure-admin.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/supertest": "^6.0.3",
    "bcryptjs": "^3.0.2",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.2",
    "jsdom": "^26.1.0",
    "pg": "^8.16.3",
    "prisma": "^7.10.0",
    "supertest": "^7.1.4",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
