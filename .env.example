DATABASE_URL="postgresql://postgres:postgres@localhost:5432/idiomas_pro?schema=public"
PORT=3333
CLIENT_ORIGIN=http://localhost:5173
VITE_API_URL=http://localhost:3333/api

# Opcionais: usados para gerar os áudios de Listening com Google Cloud TTS.
# Nunca coloque uma chave real em arquivos versionados.
GOOGLE_TTS_API_KEY=
GOOGLE_TTS_VOICE=es-ES-Chirp3-HD-Zephyr

# Administrador do painel de professores
# ADMIN_PASSWORD deve ser definida fora do repositório para criar/rotacionar a conta.
ADMIN_EMAIL=administrador@adm.com
ADMIN_PASSWORD=


# Produção / proxy Vercel
# Use somente quando o frontend/proxy precisar apontar para um backend externo.
BACKEND_API_URL=
