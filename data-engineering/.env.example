# Pode apontar para o mesmo PostgreSQL da aplicação.
DATA_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/idiomas_pro

# Origem padrão: tabelas reais da aplicação no schema public.
# Para testes de volume, use SOURCE_SCHEMA=synthetic.
SOURCE_SCHEMA=public

PIPELINE_BATCH_SIZE=1000

# Variáveis utilizadas pelo dbt.
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=idiomas_pro
DB_SCHEMA=warehouse
