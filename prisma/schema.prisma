generator client {
  provider = "prisma-client"
  output   = "../server/src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CEFRLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

enum QuestionCategory {
  GRAMMAR
  VOCABULARY
  LISTENING
}

enum MediaType {
  AUDIO
  VIDEO
}

enum AttemptStatus {
  IN_PROGRESS
  COMPLETED
}

enum TeacherRole {
  TEACHER
  ADMIN
}

model User {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  passwordHash String
  isActive     Boolean       @default(true)
  preferences  Json          @default("{}")
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  sessions     Session[]
  attempts     TestAttempt[]
}

model Session {
  id          String        @id @default(uuid())
  token       String        @unique
  clientId    String?
  userId      String?
  isAnonymous Boolean       @default(true)
  expiresAt   DateTime
  createdAt   DateTime      @default(now())
  user        User?         @relation(fields: [userId], references: [id], onDelete: Cascade)
  attempts    TestAttempt[]

  @@index([token])
  @@index([clientId])
  @@index([userId])
}

model Teacher {
  id           String           @id @default(uuid())
  name         String
  email        String           @unique
  passwordHash String
  role         TeacherRole      @default(TEACHER)
  isActive     Boolean          @default(true)
  preferences  Json             @default("{}")
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  sessions     TeacherSession[]
  attempts     TestAttempt[]

  @@index([name])
}

model TeacherSession {
  id        String   @id @default(uuid())
  token     String   @unique
  clientId  String?
  teacherId String
  expiresAt DateTime
  createdAt DateTime @default(now())
  teacher   Teacher  @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([token])
  @@index([clientId])
  @@index([teacherId])
}

model Question {
  id            String            @id @default(uuid())
  prompt        String
  options       Json
  correctAnswer String
  explanation   String?
  category      QuestionCategory
  level         CEFRLevel
  mediaType     MediaType?
  mediaUrl      String?
  isActive      Boolean           @default(true)
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt
  answers       AttemptAnswer[]

  @@index([level, category])
}

model TestAttempt {
  id             String         @id @default(uuid())
  sessionId      String
  userId         String?
  teacherId      String?
  studentName    String?
  studentEmail   String?
  language       String         @default("ES")
  status         AttemptStatus  @default(IN_PROGRESS)
  totalQuestions Int
  questionIds    Json
  score          Int?
  cefrLevel      CEFRLevel?
  breakdown      Json?
  createdAt      DateTime       @default(now())
  completedAt    DateTime?
  session        Session        @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  user           User?          @relation(fields: [userId], references: [id], onDelete: SetNull)
  teacher        Teacher?       @relation(fields: [teacherId], references: [id], onDelete: SetNull)
  answers        AttemptAnswer[]

  @@index([sessionId])
  @@index([userId, createdAt])
  @@index([teacherId, completedAt])
}

model AttemptAnswer {
  id             String           @id @default(uuid())
  attemptId      String
  questionId     String
  selectedAnswer String
  isCorrect      Boolean
  category       QuestionCategory
  questionLevel  CEFRLevel
  createdAt      DateTime         @default(now())
  attempt        TestAttempt      @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question       Question         @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([attemptId, questionId])
  @@index([attemptId])
}
